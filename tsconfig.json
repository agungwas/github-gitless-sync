{
  "compilerOptions": {
    "paths": {
      "src/*": ["./src/*"]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "es2020",
    "target": "ES6",
    "allowJs": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2022.Error"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
